APP_NAME=PolicyLens
APP_ENV=development
LOG_LEVEL=INFO

FRONTEND_ORIGIN=http://localhost:3009
VITE_API_BASE_URL=http://localhost:8009

MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
# Foundry uses its OpenAI-compatible API root (for example, https://<resource>.cognitiveservices.azure.com/openai/v1/) and deployment ID; do not use an operation URL or put credentials in the URL.
OPENAI_BASE_URL=
# Enable only when the configured custom endpoint supports the Responses API.
OPENAI_USE_RESPONSES_API=false
OPENAI_EMBEDDING_MODEL=
OPENAI_DEPLOYMENT_MODEL=gpt-6-luna
MLX_BASE_URL=http://127.0.0.1:8080/v1
MLX_MODEL=

# Choose local or openai independently of MODEL_PROVIDER.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

CHROMA_PERSIST_DIRECTORY=./data/indexes/chroma
CHROMA_COLLECTION_PREFIX=policylens
BM25_INDEX_DIRECTORY=./data/indexes/bm25
ACTIVE_CORPUS_VERSION=v1

MCP_TRANSPORT=stdio
MCP_SERVER_COMMAND=uv run --package policylens-mcp python -m policylens_mcp
MCP_SERVER_URL=
MCP_TIMEOUT_SECONDS=15

MAX_AGENT_TURNS=6
MAX_TOOL_CALLS=8
MAX_TOOL_CALLS_PER_TOOL=4
MAX_TOOL_RETRIES=1
MAX_AGENT_OUTPUT_TOKENS=1200
MAX_RETRIEVAL_CANDIDATES=20
FINAL_CONTEXT_CHUNKS=6
RERANKER_ENABLED=true
RERANKER_MODEL=jinaai/jina-reranker-v1-tiny-en
RERANKER_CANDIDATE_COUNT=20
REQUEST_TIMEOUT_SECONDS=90
# Vercel (set in the project dashboard, not in this file):
# MODEL_PROVIDER=openai
# EMBEDDING_PROVIDER=openai
# RERANKER_ENABLED=false

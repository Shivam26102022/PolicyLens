{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policylens.local/schemas/mcp-statistics-tool-v1.json",
  "title": "PolicyLens MCP query_statistics contract v1",
  "x-mcp-input-schema-sha256": "05ccc560603964c9d2723d2da6ab63d6c5fd7e2f80a471326e0df04f677004a0",
  "x-mcp-output-schema-sha256": "aa505bc99655a8828e050e2c4752a4bed7bcdb04b87b3165c275d4a89ef956d0",
  "$defs": {
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "indicator", "geographies", "start_year", "end_year", "aggregation", "group_by", "row_limit"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "indicator": { "enum": ["SL.UEM.1524.ZS", "SL.UEM.TOTL.ZS"] },
        "geographies": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z]{3}$" } },
        "start_year": { "type": "integer", "minimum": 2015, "maximum": 2025 },
        "end_year": { "type": "integer", "minimum": 2015, "maximum": 2025 },
        "aggregation": { "enum": ["none", "mean", "sum", "median"] },
        "group_by": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "enum": ["geography", "year"] } },
        "row_limit": { "type": "integer", "minimum": 1, "maximum": 44 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "aggregation": { "const": "none" } },
            "required": ["aggregation"]
          },
          "then": { "properties": { "group_by": { "maxItems": 0 } } }
        }
      ]
    },
    "RowKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "country_iso3", "year"],
      "properties": {
        "observation_id": { "type": "string", "minLength": 1, "maxLength": 500 },
        "country_iso3": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "year": { "type": "integer", "minimum": 2015, "maximum": 2025 }
      }
    },
    "ResultRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geography", "country_name", "year", "value", "unit", "observation_status", "decimal"],
      "properties": {
        "geography": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
        "country_name": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
        "year": { "type": ["integer", "null"], "minimum": 2015, "maximum": 2025 },
        "value": { "type": ["number", "null"] },
        "unit": { "type": "string", "maxLength": 100 },
        "observation_status": { "type": "string", "maxLength": 100 },
        "decimal": { "type": "integer", "minimum": 0, "maximum": 10 }
      }
    },
    "Calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "formula", "rounding"],
      "properties": {
        "operation": { "enum": ["none", "mean", "sum", "median"] },
        "formula": { "type": "string", "minLength": 1, "maxLength": 500 },
        "rounding": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "row_keys", "raw_sha256", "canonical_sha256"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "row_keys": { "type": "array", "minItems": 1, "maxItems": 44, "items": { "$ref": "#/$defs/RowKey" } },
        "raw_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "canonical_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "Attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "publisher", "licence", "attribution", "usage_constraints"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "publisher": { "type": "string", "minLength": 1, "maxLength": 500 },
        "licence": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "attribution": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "usage_constraints": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "query", "rows", "calculation", "evidence", "attribution", "warnings"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "query": { "$ref": "#/$defs/Request" },
        "rows": { "type": "array", "maxItems": 44, "items": { "$ref": "#/$defs/ResultRow" } },
        "calculation": { "$ref": "#/$defs/Calculation" },
        "evidence": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/Evidence" } },
        "attribution": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/Attribution" } },
        "warnings": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 500 } }
      }
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "error_code", "message"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "error_code": { "enum": ["STATISTICS_SOURCE_NOT_ALLOWED", "STATISTICS_INDICATOR_UNSUPPORTED", "STATISTICS_INVALID_ARGUMENTS", "STATISTICS_RANGE_INVALID", "STATISTICS_ROW_LIMIT_EXCEEDED", "STATISTICS_DATA_UNAVAILABLE", "STATISTICS_DATA_INVALID", "STATISTICS_NON_FINITE_VALUE"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "ToolOutput": {
      "type": "object",
      "title": "query_statistics_toolOutput",
      "required": ["result"],
      "properties": {
        "result": {
          "title": "Result",
          "anyOf": [
            { "$ref": "#/$defs/Result" },
            { "$ref": "#/$defs/Error" }
          ]
        }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/Request" },
    { "$ref": "#/$defs/ToolOutput" }
  ]
}
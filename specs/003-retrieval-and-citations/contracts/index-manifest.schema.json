{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policylens.local/schemas/index-manifest-v1.json",
  "title": "PolicyLens Retrieval Index Build Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "build_id", "index_version", "status", "started_at", "finished_at", "corpus_sha256", "inputs", "chunker", "tokenizer", "embedding", "bm25", "counts", "validation", "outputs"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "build_id": { "type": "string", "format": "uuid" },
    "index_version": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "enum": ["validated", "activated", "failed"] },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "corpus_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "raw_sha256", "canonical_path", "canonical_sha256", "parser_version"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "raw_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "canonical_path": { "type": "string", "minLength": 1 },
          "canonical_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "parser_version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "chunker": { "type": "object", "required": ["strategy", "version", "target_tokens", "min_tokens", "max_tokens", "overlap_tokens", "tokenizer"], "properties": { "strategy": { "type": "string" }, "version": { "type": "string" }, "target_tokens": { "type": "integer", "minimum": 1 }, "min_tokens": { "type": "integer", "minimum": 1 }, "max_tokens": { "type": "integer", "minimum": 1 }, "overlap_tokens": { "type": "integer", "minimum": 0 }, "tokenizer": { "type": "string" }, "keep_heading_with_body": { "type": "boolean" }, "preserve_lists": { "type": "boolean" }, "preserve_tables": { "type": "boolean" }, "include_section_breadcrumb": { "type": "boolean" } } },
    "tokenizer": { "type": "object", "required": ["name", "version"], "properties": { "name": { "type": "string" }, "version": { "type": "string" } } },
    "embedding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model_id", "package_version", "dimension", "normalized", "max_input_tokens", "licence", "pooling", "tokenizer", "query_method", "passage_method"],
        "licence": { "type": "string", "minLength": 1 },
        "pooling": { "type": "string", "minLength": 1 },
        "tokenizer": { "type": "string", "minLength": 1 },
        "query_method": { "type": "string", "minLength": 1 },
        "passage_method": { "type": "string", "minLength": 1 },
      "properties": {
        "provider": { "enum": ["local", "openai"] },
        "model_id": { "type": "string", "minLength": 1 },
        "package_version": { "type": "string", "minLength": 1 },
        "model_revision": { "type": ["string", "null"] },
        "model_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "dimension": { "type": "integer", "minimum": 1 },
        "normalized": { "type": "boolean" },
        "max_input_tokens": { "type": "integer", "minimum": 1 }
      }
    },
    "bm25": { "type": "object", "required": ["package_version", "method", "k1", "b"], "properties": { "package_version": { "type": "string" }, "method": { "type": "string" }, "k1": { "type": "number", "exclusiveMinimum": 0 }, "b": { "type": "number", "minimum": 0, "maximum": 1 } } },
    "counts": { "type": "object", "required": ["sources", "documents", "structured_rows", "passages", "chroma_records", "bm25_records"], "properties": { "sources": { "type": "integer", "minimum": 0 }, "documents": { "type": "integer", "minimum": 0 }, "structured_rows": { "type": "integer", "minimum": 0 }, "passages": { "type": "integer", "minimum": 0 }, "chroma_records": { "type": "integer", "minimum": 0 }, "bm25_records": { "type": "integer", "minimum": 0 } } },
    "validation": { "type": "object", "required": ["passed", "checks"], "properties": { "passed": { "type": "boolean" }, "checks": { "type": "array", "items": { "type": "string" } }, "smoke_case_ids": { "type": "array", "items": { "type": "string" } } } },
    "elapsed_seconds": { "type": ["number", "null"], "minimum": 0 },
    "outputs": { "type": "object", "required": ["chroma_path", "bm25_path"], "properties": { "chroma_path": { "type": "string" }, "bm25_path": { "type": "string" }, "chroma_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "bm25_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" } } },
    "error_code": { "type": ["string", "null"] }
  }
}

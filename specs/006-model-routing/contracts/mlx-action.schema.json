{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policylens.local/schemas/mlx-agent-action-v1.json",
  "title": "PolicyLens local MLX agent action v1",
  "$defs": {
    "StatisticsQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["indicator", "geographies", "start_year", "end_year", "aggregation", "group_by", "row_limit"],
      "properties": {
        "indicator": { "enum": ["SL.UEM.1524.ZS", "SL.UEM.TOTL.ZS"] },
        "geographies": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z]{3}$" } },
        "start_year": { "type": "integer", "minimum": 2015, "maximum": 2025 },
        "end_year": { "type": "integer", "minimum": 2015, "maximum": 2025 },
        "aggregation": { "enum": ["none", "mean", "sum", "median"] },
        "group_by": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "enum": ["geography", "year"] } },
        "row_limit": { "type": "integer", "minimum": 1, "maximum": 44 }
      },
      "allOf": [
        {
          "if": { "properties": { "aggregation": { "const": "none" } }, "required": ["aggregation"] },
          "then": { "properties": { "group_by": { "maxItems": 0 } } }
        }
      ]
    },
    "FinalAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "action", "draft"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "action": { "const": "final" },
        "draft": { "$ref": "https://policylens.local/schemas/agent-api-v1.json#/$defs/Draft" }
      }
    },
    "StatisticsAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "action", "request"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "action": { "const": "query_statistics" },
        "request": { "$ref": "#/$defs/StatisticsQuery" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/FinalAction" },
    { "$ref": "#/$defs/StatisticsAction" }
  ]
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policylens.local/schemas/model-run-metadata-v1.json",
  "title": "PolicyLens model run metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "model_id", "prompt_version", "latency_ms", "usage", "capabilities", "reasoning_effort", "reasoning_summary", "fallback_decision"],
  "properties": {
    "provider": { "enum": ["openai", "mlx"] },
    "model_id": { "type": "string", "minLength": 1, "maxLength": 300 },
    "prompt_version": { "type": "string", "minLength": 1, "maxLength": 100 },
    "latency_ms": { "type": "number", "minimum": 0 },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "prompt_tokens", "completion_tokens", "total_tokens", "cached_input_tokens", "reasoning_tokens", "cost_usd", "memory_bytes"],
      "properties": {
        "requests": { "type": ["integer", "null"], "minimum": 0 },
        "prompt_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "completion_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "reasoning_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cost_usd": { "type": ["number", "null"], "minimum": 0 },
        "memory_bytes": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "capabilities": { "$ref": "https://policylens.local/schemas/model-capabilities-v1.json" },
    "reasoning_effort": { "enum": ["none", "low", "medium", "high"] },
    "reasoning_summary": { "type": ["string", "null"], "maxLength": 4000 },
    "fallback_decision": { "const": "none" }
  }
}
